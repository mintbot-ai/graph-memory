{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_query input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "Natural-language query about facts, entities, relationships, or history."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8
    }
  },
  "required": ["query"]
}
